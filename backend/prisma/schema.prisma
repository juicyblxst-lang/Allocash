generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User { id String @id @default(cuid()) walletAddress String @unique createdAt DateTime @default(now()) smartAccount SmartAccount? presets Preset[] incomingPayments IncomingPayment[] notifications NotificationEvent[] transactionRecords TransactionRecord[] }
model SmartAccount { id String @id @default(cuid()) userId String @unique walletAddress String @unique vaultAddress String @unique chainId Int createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id], onDelete:Restrict) }
model Preset { id String @id @default(cuid()) userId String onchainPresetId String name String immutable Boolean @default(true) archived Boolean @default(false) deleted Boolean @default(false) createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id], onDelete:Restrict) containers Container[] archiveEvents PresetArchiveEvent[] allocations Allocation[] @@unique([userId,onchainPresetId]) @@index([userId,archived,deleted]) }
model Container { id String @id @default(cuid()) presetId String onchainIndex Int name String percentage Int lockDurationSeconds BigInt priority Int preset Preset @relation(fields:[presetId], references:[id], onDelete:Restrict) @@unique([presetId,onchainIndex]) }
model PresetArchiveEvent { id String @id @default(cuid()) presetId String reason String createdAt DateTime @default(now()) preset Preset @relation(fields:[presetId], references:[id], onDelete:Restrict) }
model IncomingPayment { id String @id @default(cuid()) userId String chainPaymentId String payerAddress String assetAddress String amountBaseUnits String receivedAt DateTime state String user User @relation(fields:[userId], references:[id], onDelete:Restrict) cycle AllocationCycle? @@unique([userId,chainPaymentId]) @@index([userId,receivedAt]) }
model AllocationCycle { id String @id @default(cuid()) incomingPaymentId String @unique state String decisionAt DateTime temporaryUnlockAt DateTime? reminder5SentAt DateTime? reminder10SentAt DateTime? incomingPayment IncomingPayment @relation(fields:[incomingPaymentId], references:[id], onDelete:Restrict) allocations Allocation[] }
model Allocation { id String @id @default(cuid()) cycleId String presetId String onchainAllocationId String containerIndex Int amountBaseUnits String unlockAt DateTime unlockedAt DateTime? withdrawnAt DateTime? cycle AllocationCycle @relation(fields:[cycleId], references:[id], onDelete:Restrict) preset Preset @relation(fields:[presetId], references:[id], onDelete:Restrict) lockRecords LockRecord[] @@unique([cycleId,onchainAllocationId]) @@index([presetId,withdrawnAt]) }
model LockRecord { id String @id @default(cuid()) allocationId String kind String startsAt DateTime endsAt DateTime allocation Allocation @relation(fields:[allocationId], references:[id], onDelete:Restrict) }
model NotificationEvent { id String @id @default(cuid()) userId String type String message String scheduledAt DateTime deliveredAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id], onDelete:Restrict) @@index([userId,scheduledAt,deliveredAt]) }
model TransactionRecord { id String @id @default(cuid()) userId String txHash String @unique action String status String chainId Int createdAt DateTime @default(now()) confirmedAt DateTime? user User @relation(fields:[userId], references:[id], onDelete:Restrict) @@index([userId,createdAt]) }
